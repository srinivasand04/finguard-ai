# Copy to .env and adjust. Synthetic dev values only - never real credentials.
POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard_dev
# 5432 (and 5433) are often taken by local Postgres installs, so the container maps to 55432
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380

# Used by the backend when run on the host (outside Docker)
DATABASE_URL=postgresql+psycopg://finguard:finguard_dev@localhost:55432/finguard
REDIS_URL=redis://localhost:6380/0
MODELS_DIR=../models
DATA_DIR=../data

# --- Phase 2: compliance RAG ---
QDRANT_URL=http://localhost:6333
DOCUMENTS_DIR=../documents
# LLM provider: auto | anthropic | openai | ollama | extractive
# auto = Anthropic key -> OpenAI key -> local Ollama -> extractive (quotes sources, no LLM)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- Phase 4: security ---
# Signs login tokens. Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480
# Shared password for the six demo accounts (fraud_analyst, aml_analyst, compliance_officer,
# investigation_manager, operations_manager, admin) created by `python -m app.cli seed-users` (local only)
DEMO_USER_PASSWORD=FinGuard-Demo-2026

# --- Phase 3: agents & MCP ---
# Let the LLM write the investigation narrative (falls back to a verified template if no LLM / invalid output)
AGENT_USE_LLM=true
AGENT_MAX_RETRIES=2
# Identity and mode of the MCP server; write tools stay disabled until MCP_READ_ONLY=false
MCP_ACTOR_USERNAME=mcp-service
MCP_ACTOR_ROLE=FRAUD_ANALYST
MCP_READ_ONLY=true

# --- Phase 4: observability ---
# Optional Langfuse tracing (https://langfuse.com) - leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Grafana (docker compose --profile monitoring up -d); asks to change "admin" on first login if unset
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
