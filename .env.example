# Copy to .env and adjust. Synthetic dev values only - never real credentials.
POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard_dev
# 5432 (and 5433) are often taken by local Postgres installs, so the container maps to 55432
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380

# Used by the backend when run on the host (outside Docker)
DATABASE_URL=postgresql+psycopg://finguard:finguard_dev@localhost:55432/finguard
REDIS_URL=redis://localhost:6380/0
MODELS_DIR=../models
DATA_DIR=../data

# --- Phase 2: compliance RAG ---
QDRANT_URL=http://localhost:6333
DOCUMENTS_DIR=../documents
# LLM provider: auto | anthropic | openai | ollama | extractive
# auto = Anthropic key -> OpenAI key -> local Ollama -> extractive (quotes sources, no LLM)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
